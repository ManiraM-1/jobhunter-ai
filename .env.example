# Copy this file to .env and fill in what you use. .env is git-ignored; never commit real keys.

# Contact lookup (optional): find a hiring manager's work email for a role you're applying to.
# Set one or both. hunter.io → API;  apollo.io → Settings → Integrations → API keys.
HUNTER_API_KEY=
APOLLO_API_KEY=

# Max contact lookups per day. JobHunter is for a few targeted contacts, not lists.
JOBHUNTER_LOOKUP_DAILY_CAP=20
